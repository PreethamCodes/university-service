{
  "openapi": "3.1.0",
  "info": {
    "title": "University Records",
    "version": "2.0.0"
  },
  "security": [
    {
      "DemoToken": []
    }
  ],
  "paths": {
    "/demo/token": {
      "post": {
        "summary": "Exchange demo client credentials for a time-limited bearer token",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string",
                      "minLength": 1
                    },
                    "token_type": {
                      "const": "Bearer"
                    },
                    "expires_in": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "access_token",
                    "token_type",
                    "expires_in"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Record missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Provider error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Provider unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "ClientCredentials": []
          }
        ]
      }
    },
    "/api/v2/students/{student_id}/academic-records": {
      "get": {
        "summary": "Read academic registration; expired tokens receive 401",
        "parameters": [
          {
            "name": "student_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^MHSTU[0-9]{4}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "student": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "id"
                      ],
                      "additionalProperties": false
                    },
                    "academic": {
                      "type": "object",
                      "properties": {
                        "registration": {
                          "type": "object",
                          "properties": {
                            "reference": {
                              "type": "string",
                              "minLength": 1
                            },
                            "status": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "reference",
                            "status"
                          ],
                          "additionalProperties": false
                        },
                        "programme": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1
                            },
                            "department": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "required": [
                                "name"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "name",
                            "department"
                          ],
                          "additionalProperties": false
                        },
                        "enrolment_status": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "registration",
                        "programme",
                        "enrolment_status"
                      ],
                      "additionalProperties": false
                    },
                    "documents": {
                      "type": "object",
                      "properties": {
                        "bonafide": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "valid_until": {
                                  "type": "string",
                                  "format": "date"
                                }
                              },
                              "required": [
                                "valid_until"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "bonafide"
                      ],
                      "additionalProperties": false
                    },
                    "record_reference": {
                      "type": "string",
                      "minLength": 1
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "student",
                    "academic",
                    "documents",
                    "record_reference",
                    "updated_at"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Record missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Provider error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Provider unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DemoToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Expiring prototype token"
      },
      "ClientCredentials": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "INPUT",
              "AUTHENTICATION",
              "PERMISSION",
              "MISSING",
              "CONFLICT",
              "PROVIDER",
              "INTERNAL"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "transaction_reference": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "provider_reference": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "code",
          "category",
          "message",
          "transaction_reference",
          "provider_reference",
          "retryable",
          "timestamp"
        ],
        "additionalProperties": false
      }
    }
  }
}
